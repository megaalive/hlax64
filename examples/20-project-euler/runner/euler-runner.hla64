// euler-runner.hla64 — dispatch Project Euler solvers via argv[1] (problems 1–25).
//
// Usage:
//   hla64 run examples/20-project-euler/runner/euler-runner.hla64 -- 1
//   hla64 run examples/20-project-euler/runner/euler-runner.hla64 -- 15

program euler_runner;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;

procedure ParseU64(text: ptr); @returns("rax");
begin ParseU64;
    mov(0, rax);
    mov(text, r11);
    mov([r11].byte, r10);

    while(r10 > 0) do
        if(r10 < 48) then
            mov(0, r10);
        else
            if(r10 > 57) then
                mov(0, r10);
            else
                mov(rax, r12);
                mov(10, r13);
                imul(r13, r12);
                mov(r10, r13);
                sub(48, r13);
                add(r13, r12);
                mov(r12, rax);
                add(1, r11);
                mov([r11].byte, r10);
            endif;
        endif;
    endwhile;
end ParseU64;

procedure Solve001(); @returns("rax");
var
    i: uint64;
    total: uint64;
begin Solve001;
    mov(0, i);
    mov(0, total);
    mov(1000, rbx);

    while(i < rbx) do
        mov(i, rax);
        mov(3, r10);
        mod(r10, rax);

        if(rax = 0) then
            mov(i, r11);
            add(r11, total);
        else
            mov(i, rax);
            mov(5, r10);
            mod(r10, rax);

            if(rax = 0) then
                mov(i, r11);
                add(r11, total);
            endif;
        endif;

        add(1, i);
    endwhile;

    mov(total, rax);
end Solve001;

procedure Solve002(); @returns("rax");
var
    a: uint64;
    b: uint64;
    total: uint64;
begin Solve002;
    mov(1, a);
    mov(2, b);
    mov(0, total);
    mov(4000001, rbx);

    while(b < rbx) do
        mov(b, rax);
        mov(2, r10);
        mod(r10, rax);

        if(rax = 0) then
            mov(b, r11);
            add(r11, total);
        endif;

        mov(a, r11);
        mov(b, r12);
        add(r12, r11);
        mov(r12, a);
        mov(r11, b);
    endwhile;

    mov(total, rax);
end Solve002;

procedure Solve003(); @returns("rax");
var
    n: uint64;
    factor: uint64;
    largest: uint64;
begin Solve003;
    mov(600851475143, n);
    mov(2, factor);
    mov(1, largest);
    mov(1000000, rbx);

    while(factor < rbx) do
        mov(n, r14);

        if(r14 = 1) then
            mov(rbx, factor);
        else
            mov(n, rax);
            mov(factor, r10);
            mod(r10, rax);

            if(rax = 0) then
                mov(factor, r10);
                mov(r10, largest);
                mov(n, rax);
                mov(factor, r10);
                idiv(r10, rax);
                mov(rax, n);
            else
                add(1, factor);
            endif;
        endif;
    endwhile;

    mov(largest, rax);
end Solve003;

begin euler_runner;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("Usage: euler-runner <1..25>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        call ParseU64(rax);
        mov(rax, r12);

        if(r12 = 1) then
            call Solve001();
            stdout.put("Euler #1 = ", rax, nl);
            mov(0, rbx);
        else
            if(r12 = 2) then
                call Solve002();
                stdout.put("Euler #2 = ", rax, nl);
                mov(0, rbx);
            else
                if(r12 = 3) then
                    call Solve003();
                    stdout.put("Euler #3 = ", rax, nl);
                    mov(0, rbx);
                else
                    if(r12 > 25) then
                        stdout.put("Unknown problem (supported: 1..25)", nl);
                        mov(1, rbx);
                    else
                        stdout.put("Run problems/euler file for problem ", r12, nl);
                        mov(0, rbx);
                    endif;
                endif;
            endif;
        endif;
    endif;
end euler_runner;
