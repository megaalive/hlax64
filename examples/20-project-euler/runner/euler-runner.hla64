// euler-runner.hla64 — dispatch early Project Euler solvers via argv[1].
//
// Usage:
//   hla64 run examples/20-project-euler/runner/euler-runner.hla64 -- 1
//   hla64 run examples/20-project-euler/runner/euler-runner.hla64 -- 2
//   hla64 run examples/20-project-euler/runner/euler-runner.hla64 -- 3

program euler_runner;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;

procedure Solve001(); @returns("rax");
var
    i: uint64;
    total: uint64;
begin Solve001;
    mov(0, i);
    mov(0, total);
    mov(1000, rbx);

    while(i < rbx) do
        mov(i, rax);
        mov(3, r10);
        mod(r10, rax);

        if(rax = 0) then
            mov(i, r11);
            add(r11, total);
        else
            mov(i, rax);
            mov(5, r10);
            mod(r10, rax);

            if(rax = 0) then
                mov(i, r11);
                add(r11, total);
            endif;
        endif;

        add(1, i);
    endwhile;

    mov(total, rax);
end Solve001;

procedure Solve002(); @returns("rax");
var
    a: uint64;
    b: uint64;
    total: uint64;
begin Solve002;
    mov(1, a);
    mov(2, b);
    mov(0, total);
    mov(4000001, rbx);

    while(b < rbx) do
        mov(b, rax);
        mov(2, r10);
        mod(r10, rax);

        if(rax = 0) then
            mov(b, r11);
            add(r11, total);
        endif;

        mov(a, r11);
        mov(b, r12);
        add(r12, r11);
        mov(r12, a);
        mov(r11, b);
    endwhile;

    mov(total, rax);
end Solve002;

procedure Solve003(); @returns("rax");
var
    n: uint64;
    factor: uint64;
    largest: uint64;
begin Solve003;
    mov(600851475143, n);
    mov(2, factor);
    mov(1, largest);
    mov(1000000, rbx);

    while(factor < rbx) do
        mov(n, r14);

        if(r14 = 1) then
            mov(rbx, factor);
        else
            mov(n, rax);
            mov(factor, r10);
            mod(r10, rax);

            if(rax = 0) then
                mov(factor, r10);
                mov(r10, largest);
                mov(n, rax);
                mov(factor, r10);
                idiv(r10, rax);
                mov(rax, n);
            else
                add(1, factor);
            endif;
        endif;
    endwhile;

    mov(largest, rax);
end Solve003;

begin euler_runner;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("Usage: euler-runner <1|2|3>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        mov([r12].byte, r11);

        if(r11 = 49) then
            call Solve001();
            stdout.put("Euler #1", nl);
            stdout.put("Answer: ", rax, nl);
            mov(0, rbx);
        else
            if(r11 = 50) then
                call Solve002();
                stdout.put("Euler #2", nl);
                stdout.put("Answer: ", rax, nl);
                mov(0, rbx);
            else
                if(r11 = 51) then
                    call Solve003();
                    stdout.put("Euler #3", nl);
                    stdout.put("Answer: ", rax, nl);
                    mov(0, rbx);
                else
                    stdout.put("Unknown problem (supported: 1, 2, 3)", nl);
                    mov(1, rbx);
                endif;
            endif;
        endif;
    endif;
end euler_runner;
