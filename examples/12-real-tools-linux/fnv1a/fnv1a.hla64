// fnv1a.hla64 - FNV-1a 64-bit hash of a file (argv[1]) (Linux SysV).
//
// Stress: Linux argv runtime, imul/xor loop, stdout.putu for unsigned hash display.

program fnv1a;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;

extern procedure open(path: cstring; flags: int32; mode: int32): int32 from "libc.so";
extern procedure read(fd: int32; buf: ptr; count: int64): int64 from "libc.so";
extern procedure close(fd: int32): int32 from "libc.so";

static
    buffer: byte[256];
endstatic;

const
    FnvOffset := $cbf29ce484222325;
    FnvPrime  := $100000001b3;
endconst;

procedure HashBuffer(data: ptr; n: int64); @returns("rax");
begin HashBuffer;
    mov(FnvOffset, r11);
    mov(0, r8);
    mov(data, r10);

    while(r8 < n) do
        mov([r10].byte, r9);
        xor(r9, r11);
        mov(FnvPrime, rax);
        imul(rax, r11);
        add(1, r8);
        add(1, r10);
    endwhile;

    mov(r11, rax);
end HashBuffer;

begin fnv1a;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("usage: fnv1a <file>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call open(r12, 0, 0);

        if(rax < 0) then
            stdout.put("open failed", nl);
            mov(1, rbx);
        else
            mov(rax, r15);
            call read(r15, &buffer, 256);
            if(rax < 0) then
                stdout.put("read failed", nl);
                call close(r15);
                mov(1, rbx);
            else
                mov(rax, r13);
                call HashBuffer(&buffer, r13);
                stdout.putu("fnv1a=", rax, nl);
                call close(r15);
                mov(0, rbx);
            endif;
        endif;
    endif;
end fnv1a;
