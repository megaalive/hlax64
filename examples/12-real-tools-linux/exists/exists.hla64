// exists.hla64 - return 0 when argv[1] exists, 1 otherwise (Linux SysV).
//
// Stress: Linux argv runtime, access(2), branch, process exit code.

program exists;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;

extern procedure access(path: cstring; mode: int32): int32 from "libc.so";

begin exists;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("usage: exists <path>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call access(r12, 0);

        if(rax < 0) then
            stdout.put("missing", nl);
            mov(1, rbx);
        else
            stdout.put("exists", nl);
            mov(0, rbx);
        endif;
    endif;
end exists;
