// wc.hla64 - count lines, words, and bytes in a file (argv[1]) (Linux SysV).
//
// Stress: Linux argv runtime, libc open/read/close, byte classification.

program wc;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;

extern procedure open(path: cstring; flags: int32; mode: int32): int32 from "libc.so";
extern procedure read(fd: int32; buf: ptr; count: int64): int64 from "libc.so";
extern procedure close(fd: int32): int32 from "libc.so";

static
    buffer: byte[256];
endstatic;

procedure IsSpace(b: int64); @returns("rax");
begin IsSpace;
    mov(0, rax);
    if(b = 32) then mov(1, rax); endif;
    if(b = 9) then mov(1, rax); endif;
    if(b = 10) then mov(1, rax); endif;
    if(b = 13) then mov(1, rax); endif;
end IsSpace;

procedure CountBuffer(data: ptr; n: int64); @returns("rax");
begin CountBuffer;
    mov(0, r11);
    mov(0, r12);
    mov(0, r13);
    mov(0, r8);
    mov(data, r14);
    mov(n, r15);

    while(r8 < r15) do
        mov([r14].byte, r9);

        if(r9 = 10) then
            add(1, r11);
        endif;

        call IsSpace(r9);
        if(rax = 0) then
            if(r13 = 0) then
                add(1, r12);
                mov(1, r13);
            endif;
        else
            mov(0, r13);
        endif;

        add(1, r8);
        add(1, r14);
    endwhile;

    stdout.put("lines=", r11, " words=", r12, " bytes=", r15, nl);
    mov(0, rax);
end CountBuffer;

begin wc;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("usage: wc <file>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call open(r12, 0, 0);

        if(rax < 0) then
            stdout.put("open failed", nl);
            mov(1, rbx);
        else
            mov(rax, r15);
            call read(r15, &buffer, 256);
            if(rax < 0) then
                stdout.put("read failed", nl);
                call close(r15);
                mov(1, rbx);
            else
                mov(rax, r13);
                call CountBuffer(&buffer, r13);
                call close(r15);
                mov(0, rbx);
            endif;
        endif;
    endif;
end wc;
