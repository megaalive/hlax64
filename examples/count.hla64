// count.hla64
// Demonstrates a while loop, comparison, and printing a register as
// a decimal integer. The first program in HlaX64 that exercises the
// control-flow lowering path end-to-end.

program count;
begin count;
    mov(0, rcx);

    while(rcx < 5) do
        stdout.put("count = ", rcx, nl);
        add(1, rcx);
    endwhile;
end count;
