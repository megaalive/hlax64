<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Target Name="CopyNativeDll" AfterTargets="Build">
    <PropertyGroup>
      <NativeDllSource>$(MSBuildThisFileDirectory)..\..\..\..\build\native_fnv1a\libnative_fnv1a.dll</NativeDllSource>
    </PropertyGroup>
    <Copy SourceFiles="$(NativeDllSource)"
          DestinationFiles="$(OutputPath)native_fnv1a.dll"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NativeDllSource)')" />
  </Target>

</Project>
