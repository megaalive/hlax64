// strings.hla64 - print printable runs (length >= 4) from argv[1] (Windows MS ABI).
//
// Stress: hlax_is_printable, run buffer across chunk boundaries, hlax_stdout_write.

program strings;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;
extern procedure hlax_file_open_read(path: cstring): int64;
extern procedure hlax_file_read(handle: int64; buffer: ptr; count: uint64): int64;
extern procedure hlax_file_close(handle: int64): int64;
extern procedure hlax_stdout_write(buffer: ptr; count: uint64): int64;
extern procedure hlax_is_printable(ch: uint64): int64;

static
    buffer: byte[256];
    run: byte[128];
    runLen: int64;
    nlByte: byte := 10;
endstatic;

procedure FlushRun(); @returns("rax");
begin FlushRun;
    if(runLen >= 4) then
        call hlax_stdout_write(&run, runLen);
        call hlax_stdout_write(&nlByte, 1);
    endif;
    mov(0, runLen);
    mov(0, rax);
end FlushRun;

procedure ProcessByte(b: int64); @returns("rax");
begin ProcessByte;
    call hlax_is_printable(b);
    if(rax != 0) then
        mov(&run, r10);
        mov(runLen, r11);
        add(r11, r10);
        mov([r11].byte, b);
        add(1, runLen);
    else
        call FlushRun();
    endif;
    mov(0, rax);
end ProcessByte;

procedure ProcessBuffer(n: int64); @returns("rax");
begin ProcessBuffer;
    mov(&buffer, r14);
    mov(0, r8);
    while(r8 < n) do
        mov([r14].byte, r9);
        call ProcessByte(r9);
        add(1, r14);
        add(1, r8);
    endwhile;
    call FlushRun();
    mov(0, rax);
end ProcessBuffer;

procedure ScanLoop(handle: int64); @returns("rax");
begin ScanLoop;
    mov(0, r13);
    while(r13 = 0) do
        call hlax_file_read(handle, &buffer, 256);
        if(rax < 0) then
            mov(-1, rax);
            mov(1, r13);
        else
            if(rax = 0) then
                mov(0, rax);
                mov(1, r13);
            else
                mov(rax, r12);
                call ProcessBuffer(r12);
            endif;
        endif;
    endwhile;
end ScanLoop;

begin strings;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("usage: strings <file>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call hlax_file_open_read(r12);

        if(rax = -1) then
            stdout.put("open failed", nl);
            mov(1, rbx);
        else
            mov(rax, r15);
            mov(0, runLen);
            call ScanLoop(r15);
            if(rax < 0) then
                stdout.put("read failed", nl);
                call hlax_file_close(r15);
                mov(1, rbx);
            else
                call hlax_file_close(r15);
                mov(0, rbx);
            endif;
        endif;
    endif;
end strings;
