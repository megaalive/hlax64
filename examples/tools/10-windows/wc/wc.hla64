// wc.hla64 - count lines, words, and bytes in a file (argv[1]).
//
// Stress: argv runtime, hlax_file_* stdlib, byte classification, multiple counters,
// multi-value stdout.put, while+if nesting.

program wc;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;
extern procedure hlax_file_open_read(path: cstring): int64;
extern procedure hlax_file_read(handle: int64; buffer: ptr; count: uint64): int64;
extern procedure hlax_file_close(handle: int64): int64;
extern procedure hlax_is_space(ch: uint64): int64;

static
    buffer: byte[256];
    bytesRead: int64;
endstatic;

procedure IsSpace(b: int64); @returns("rax");
begin IsSpace;
    call hlax_is_space(b);
end IsSpace;

procedure CountBuffer(n: int64); @returns("rax");
begin CountBuffer;
    mov(0, r11);
    mov(0, r12);
    mov(0, r13);
    mov(n, r15);
    mov(&buffer, r14);
    mov(r14, r10);
    add(r15, r10);

    while(r14 < r10) do
        mov([r14].byte, r9);

        if(r9 = 10) then
            add(1, r11);
        endif;

        call IsSpace(r9);
        if(rax = 0) then
            if(r13 = 0) then
                add(1, r12);
                mov(1, r13);
            endif;
        else
            mov(0, r13);
        endif;

        add(1, r14);
    endwhile;

    stdout.put("lines=", r11, " words=", r12, " bytes=", r15, nl);
    mov(0, rax);
end CountBuffer;

begin wc;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("usage: wc <file>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call hlax_file_open_read(r12);

        if(rax = -1) then
            stdout.put("open failed", nl);
            mov(1, rbx);
        else
            mov(rax, r15);
            call hlax_file_read(r15, &buffer, 256);
            mov(rax, bytesRead);
            if(bytesRead < 0) then
                stdout.put("read failed", nl);
                call hlax_file_close(r15);
                mov(1, rbx);
            else
                mov(bytesRead, r10);
                call CountBuffer(r10);
                call hlax_file_close(r15);
                mov(0, rbx);
            endif;
        endif;
    endif;
end wc;
