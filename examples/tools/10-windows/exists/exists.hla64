// exists.hla64 - return 0 when argv[1] exists, 1 otherwise.
//
// Stress: argv runtime, minimal Win32 interop, branch, process exit code.

program exists;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;

extern procedure GetFileAttributesA(lpFileName: cstring): uint64 from "kernel32.dll";

begin exists;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("usage: exists <path>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call GetFileAttributesA(r12);

        if(rax = -1) then
            stdout.put("missing", nl);
            mov(1, rbx);
        else
            stdout.put("exists", nl);
            mov(0, rbx);
        endif;
    endif;
end exists;
