// cp.hla64 - copy file bytes from argv[1] to argv[2] (Linux SysV).
//
// Stress: read/write loop, hlax_file_open_write, hlax_file_write.

program cp;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;
extern procedure hlax_file_open_read(path: cstring): int64;
extern procedure hlax_file_open_write(path: cstring): int64;
extern procedure hlax_file_read(handle: int64; buffer: ptr; count: uint64): int64;
extern procedure hlax_file_write(handle: int64; buffer: ptr; count: uint64): int64;
extern procedure hlax_file_close(handle: int64): int64;

static
    buffer: byte[256];
endstatic;

procedure CopyLoop(readHandle: int64; writeHandle: int64); @returns("rax");
begin CopyLoop;
    mov(0, r13);
    while(r13 = 0) do
        call hlax_file_read(readHandle, &buffer, 256);
        if(rax < 0) then
            mov(-1, rax);
            mov(1, r13);
        else
            if(rax = 0) then
                mov(0, rax);
                mov(1, r13);
            else
                mov(rax, r12);
                call hlax_file_write(writeHandle, &buffer, r12);
                if(rax < 0) then
                    mov(-1, rax);
                    mov(1, r13);
                endif;
            endif;
        endif;
    endwhile;
end CopyLoop;

begin cp;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 3) then
        stdout.put("usage: cp <src> <dst>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call hlax_file_open_read(r12);

        if(rax < 0) then
            stdout.put("open src failed", nl);
            mov(1, rbx);
        else
            mov(rax, r14);
            call hlax_argv_get(2);
            mov(rax, r12);
            call hlax_file_open_write(r12);

            if(rax < 0) then
                stdout.put("open dst failed", nl);
                call hlax_file_close(r14);
                mov(1, rbx);
            else
                mov(rax, r15);
                call CopyLoop(r14, r15);
                if(rax < 0) then
                    stdout.put("io failed", nl);
                    call hlax_file_close(r14);
                    call hlax_file_close(r15);
                    mov(1, rbx);
                else
                    call hlax_file_close(r14);
                    call hlax_file_close(r15);
                    mov(0, rbx);
                endif;
            endif;
        endif;
    endif;
end cp;
