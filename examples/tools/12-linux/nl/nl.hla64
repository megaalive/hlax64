// nl.hla64 - number lines in argv[1] (Linux SysV).
//
// Stress: read loop, line prefix via stdout.put, hlax_stdout_write.

program nl;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;
extern procedure hlax_file_open_read(path: cstring): int64;
extern procedure hlax_file_read(handle: int64; buffer: ptr; count: uint64): int64;
extern procedure hlax_file_close(handle: int64): int64;
extern procedure hlax_stdout_write(buffer: ptr; count: uint64): int64;

static
    buffer: byte[256];
    oneByte: byte[1];
    lineNum: int64 := 1;
    atStart: int64 := 1;
endstatic;

procedure WriteByte(b: int64); @returns("rax");
begin WriteByte;
    mov(&oneByte, r10);
    mov(b, [r10].byte);
    call hlax_stdout_write(&oneByte, 1);
    mov(0, rax);
end WriteByte;

procedure MaybePrefix(); @returns("rax");
begin MaybePrefix;
    if(atStart != 0) then
        mov(lineNum, rax);
        stdout.put(rax, " ");
        mov(0, atStart);
    endif;
    mov(0, rax);
end MaybePrefix;

procedure ProcessByte(b: int64); @returns("rax");
begin ProcessByte;
    call MaybePrefix();
    call WriteByte(b);
    if(b = 10) then
        add(1, lineNum);
        mov(1, atStart);
    endif;
    mov(0, rax);
end ProcessByte;

procedure ProcessBuffer(n: int64); @returns("rax");
begin ProcessBuffer;
    mov(0, r12);
    mov(n, r13);
    while(r12 < r13) do
        mov(&buffer, r14);
        add(r12, r14);
        mov([r14].byte, r9);
        call ProcessByte(r9);
        add(1, r12);
    endwhile;
    mov(0, rax);
end ProcessBuffer;

procedure NlLoop(handle: int64); @returns("rax");
begin NlLoop;
    mov(1, lineNum);
    mov(1, atStart);
    mov(0, r13);
    while(r13 = 0) do
        call hlax_file_read(handle, &buffer, 256);
        if(rax < 0) then
            mov(-1, rax);
            mov(1, r13);
        else
            if(rax = 0) then
                mov(0, rax);
                mov(1, r13);
            else
                mov(rax, r12);
                call ProcessBuffer(r12);
            endif;
        endif;
    endwhile;
end NlLoop;

begin nl;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("usage: nl <file>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call hlax_file_open_read(r12);

        if(rax < 0) then
            stdout.put("open failed", nl);
            mov(1, rbx);
        else
            mov(rax, r15);
            call NlLoop(r15);
            if(rax < 0) then
                stdout.put("io failed", nl);
                call hlax_file_close(r15);
                mov(1, rbx);
            else
                call hlax_file_close(r15);
                mov(0, rbx);
            endif;
        endif;
    endif;
end nl;
