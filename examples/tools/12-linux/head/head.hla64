// head.hla64 - print first 10 lines of argv[1] (Linux SysV).
//
// Stress: read loop, newline counting, hlax_stdout_write.

program head;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;
extern procedure hlax_file_open_read(path: cstring): int64;
extern procedure hlax_file_read(handle: int64; buffer: ptr; count: uint64): int64;
extern procedure hlax_file_close(handle: int64): int64;
extern procedure hlax_stdout_write(buffer: ptr; count: uint64): int64;

static
    buffer: byte[256];
    oneByte: byte[1];
    lineLimit: int64 := 10;
    linesOut: int64;
    headDone: int64;
endstatic;

procedure WriteByte(b: int64); @returns("rax");
begin WriteByte;
    mov(&oneByte, r10);
    mov(b, [r10].byte);
    call hlax_stdout_write(&oneByte, 1);
    mov(0, rax);
end WriteByte;

procedure ProcessBuffer(data: ptr; n: int64; limit: int64); @returns("rax");
begin ProcessBuffer;
    mov(limit, r10);
    mov(n, r13);
    mov(0, r12);
    while(r12 < r13) do
        if(headDone != 0) then
            mov(r13, r12);
        else
            mov(data, r14);
            add(r12, r14);
            mov([r14].byte, r9);
            call WriteByte(r9);
            if(r9 = 10) then
                add(1, linesOut);
                if(linesOut >= r10) then
                    mov(1, headDone);
                endif;
            endif;
            add(1, r12);
        endif;
    endwhile;
    mov(headDone, rax);
end ProcessBuffer;

procedure HeadLoop(handle: int64; limit: int64); @returns("rax");
begin HeadLoop;
    mov(0, linesOut);
    mov(0, headDone);
    mov(0, r13);
    while(r13 = 0) do
        call hlax_file_read(handle, &buffer, 256);
        if(rax < 0) then
            mov(-1, rax);
            mov(1, r13);
        else
            if(rax = 0) then
                mov(0, rax);
                mov(1, r13);
            else
                mov(rax, r11);
                call ProcessBuffer(&buffer, r11, limit);
                if(rax != 0) then
                    mov(0, rax);
                    mov(1, r13);
                endif;
            endif;
        endif;
    endwhile;
end HeadLoop;

begin head;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("usage: head <file>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call hlax_file_open_read(r12);

        if(rax < 0) then
            stdout.put("open failed", nl);
            mov(1, rbx);
        else
            mov(rax, r15);
            call HeadLoop(r15, lineLimit);
            if(rax < 0) then
                stdout.put("io failed", nl);
                call hlax_file_close(r15);
                mov(1, rbx);
            else
                call hlax_file_close(r15);
                mov(0, rbx);
            endif;
        endif;
    endif;
end head;
