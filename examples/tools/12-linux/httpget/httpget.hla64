// httpget.hla64 - HTTP/1.0 GET for host:port and path argv[3].

program httpget;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;
extern procedure hlax_net_init(): int64;
extern procedure hlax_net_last_error(): int64;
extern procedure hlax_tcp_connect(host: cstring; port: uint64): int64;
extern procedure hlax_tcp_set_timeouts_ms(socket: int64; recv_ms: uint64; send_ms: uint64): int64;
extern procedure hlax_tcp_write_all(socket: int64; buffer: ptr; count: uint64): int64;
extern procedure hlax_tcp_read(socket: int64; buffer: ptr; count: uint64): int64;
extern procedure hlax_tcp_close(socket: int64): int64;
extern procedure hlax_stdout_write(buffer: ptr; count: uint64): int64;
extern procedure hlax_strlen(buf: cstring): uint64;
extern procedure hlax_memcpy(dst: ptr; src: ptr; count: uint64): ptr;

static
    reqBuf: byte[512];
    reqLen: int64;
    readBuf: byte[256];
endstatic;

procedure ParsePort(str: ptr); @returns("rax");
begin ParsePort;
    mov(0, rax);
    mov(str, r10);
    mov(0, r15);
    while(r15 < 6) do
        mov([r10].byte, r9);
        if(r9 = 0) then
            mov(6, r15);
        else
            imul(10, rax);
            sub(48, r9);
            add(r9, rax);
            add(1, r10);
            add(1, r15);
        endif;
    endwhile;
end ParsePort;

procedure AppendStr(src: ptr); @returns("rax");
begin AppendStr;
    call hlax_strlen(src);
    mov(rax, r9);
    mov(reqLen, r11);
    mov(&reqBuf, r12);
    add(r11, r12);
    call hlax_memcpy(r12, src, r9);
    add(r9, reqLen);
    mov(0, rax);
end AppendStr;

procedure BuildRequest(host: ptr; path: ptr); @returns("rax");
begin BuildRequest;
    mov(0, reqLen);
    call AppendStr("GET ");
    call AppendStr(path);
    call AppendStr(" HTTP/1.0\nHost: ");
    call AppendStr(host);
    call AppendStr("\n\n");
    mov(reqLen, rax);
end BuildRequest;

begin httpget;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 4) then
        stdout.put("usage: httpget <host> <port> <path>", nl);
        mov(1, rbx);
    else
        call hlax_net_init();
        if(rax != 0) then
            call hlax_net_last_error();
            stdout.put("err=", rax, nl);
            mov(3, rbx);
        else
            call hlax_argv_get(2);
            call ParsePort(rax);
            mov(rax, r13);
            call hlax_argv_get(1);
            mov(rax, r12);
            call hlax_argv_get(3);
            mov(rax, r11);
            call BuildRequest(r12, r11);
            call hlax_argv_get(1);
            mov(rax, r12);
            call hlax_tcp_connect(r12, r13);

            if(rax < 0) then
                call hlax_net_last_error();
                stdout.put("err=", rax, nl);
                mov(3, rbx);
            else
                mov(rax, r14);
                call hlax_tcp_set_timeouts_ms(r14, 5000, 5000);
                call hlax_tcp_write_all(r14, &reqBuf, reqLen);
                call hlax_tcp_read(r14, &readBuf, 256);
                if(rax > 0) then
                    call hlax_stdout_write(&readBuf, rax);
                endif;
                call hlax_tcp_close(r14);
                mov(0, rbx);
            endif;
        endif;
    endif;
end httpget;

