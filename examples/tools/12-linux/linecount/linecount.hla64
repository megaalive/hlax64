// linecount.hla64 - count newline bytes in a file passed as argv[1] (Linux SysV).
//
// Stress: Linux argv runtime, libc open/read/close, while+if.

program linecount;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;

extern procedure open(path: cstring; flags: int32; mode: int32): int32 from "libc.so";
extern procedure read(fd: int32; buf: ptr; count: int64): int64 from "libc.so";
extern procedure close(fd: int32): int32 from "libc.so";

static
    buffer: byte[256];
endstatic;

procedure CountBuffer(data: ptr; n: int64); @returns("rax");
begin CountBuffer;
    mov(0, r11);
    mov(0, r8);
    mov(data, r14);

    while(r8 < n) do
        mov([r14].byte, r9);
        if(r9 = 10) then
            add(1, r11);
        endif;
        add(1, r8);
        add(1, r14);
    endwhile;

    mov(r11, rax);
end CountBuffer;

begin linecount;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("usage: linecount <file>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call open(r12, 0, 0);

        if(rax < 0) then
            stdout.put("open failed", nl);
            mov(1, rbx);
        else
            mov(rax, r15);
            call read(r15, &buffer, 256);
            if(rax < 0) then
                stdout.put("read failed", nl);
                call close(r15);
                mov(1, rbx);
            else
                mov(rax, r10);
                call CountBuffer(&buffer, r10);
                mov(rax, r12);
                stdout.put("lines: ", r12, nl);
                call close(r15);
                mov(0, rbx);
            endif;
        endif;
    endif;
end linecount;
