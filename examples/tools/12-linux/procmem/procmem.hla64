// procmem.hla64 - print resident set size for current process.

program procmem;

#include("stdlib64.hhf")

extern procedure hlax_self_rss_bytes(): int64;
extern procedure hlax_os_last_error(): int64;

begin procmem;
    call hlax_self_rss_bytes();

    if(rax < 0) then
        call hlax_os_last_error();
        stdout.put("err=", rax, nl);
        mov(2, rbx);
    else
        stdout.put("rss=", rax, nl);
        mov(0, rbx);
    endif;
end procmem;
