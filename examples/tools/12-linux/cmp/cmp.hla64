// cmp.hla64 - byte-compare two files (argv[1], argv[2]) (Linux SysV).
//
// Stress: dual hlax_file_* handles, streaming compare loop.

program cmp;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;
extern procedure hlax_file_open_read(path: cstring): int64;
extern procedure hlax_file_read(handle: int64; buffer: ptr; count: uint64): int64;
extern procedure hlax_file_close(handle: int64): int64;

static
    buffer1: byte[256];
    buffer2: byte[256];
    read1: int64;
    read2: int64;
endstatic;

procedure CompareChunk(n: int64; baseOffset: int64); @returns("rax");
begin CompareChunk;
    mov(&buffer1, r14);
    mov(&buffer2, r15);
    mov(0, r8);
    mov(0, rax);
    while(r8 < n) do
        mov([r14].byte, r10);
        mov([r15].byte, r11);
        if(r10 != r11) then
            mov(baseOffset, r9);
            add(r8, r9);
            stdout.put("differ at ", r9, nl);
            mov(1, rax);
            mov(r8, n);
        else
            add(1, r14);
            add(1, r15);
            add(1, r8);
        endif;
    endwhile;
end CompareChunk;

procedure CompareLoop(h1: int64; h2: int64); @returns("rax");
begin CompareLoop;
    mov(0, r12);
    mov(0, r13);
    while(r13 = 0) do
        call hlax_file_read(h1, &buffer1, 256);
        if(rax < 0) then
            mov(-1, rax);
            mov(1, r13);
        else
            mov(rax, read1);
            call hlax_file_read(h2, &buffer2, 256);
            if(rax < 0) then
                mov(-1, rax);
                mov(1, r13);
            else
                mov(rax, read2);
                if(read1 = 0) then
                    if(read2 = 0) then
                        stdout.put("identical", nl);
                        mov(0, rax);
                        mov(1, r13);
                    else
                        stdout.put("differ: size", nl);
                        mov(1, rax);
                        mov(1, r13);
                    endif;
                else
                    mov(read1, r10);
                    mov(read2, r11);
                    if(r10 != r11) then
                        stdout.put("differ: size", nl);
                        mov(1, rax);
                        mov(1, r13);
                    else
                        call CompareChunk(read1, r12);
                        if(rax != 0) then
                            mov(1, r13);
                        else
                            add(read1, r12);
                        endif;
                    endif;
                endif;
            endif;
        endif;
    endwhile;
end CompareLoop;

begin cmp;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 3) then
        stdout.put("usage: cmp <file-a> <file-b>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call hlax_file_open_read(r12);

        if(rax < 0) then
            stdout.put("open failed", nl);
            mov(1, rbx);
        else
            mov(rax, r14);
            call hlax_argv_get(2);
            mov(rax, r12);
            call hlax_file_open_read(r12);

            if(rax < 0) then
                stdout.put("open failed", nl);
                call hlax_file_close(r14);
                mov(1, rbx);
            else
                mov(rax, r15);
                call CompareLoop(r14, r15);
                mov(rbx, rax);
                call hlax_file_close(r14);
                if(rax < 0) then
                    stdout.put("io failed", nl);
                    call hlax_file_close(r15);
                    mov(1, rbx);
                else
                    call hlax_file_close(r15);
                    if(rax < 0) then
                        stdout.put("io failed", nl);
                        mov(1, rbx);
                    else
                        if(rbx < 0) then
                            stdout.put("io failed", nl);
                            mov(1, rbx);
                        endif;
                    endif;
                endif;
            endif;
        endif;
    endif;
end cmp;
