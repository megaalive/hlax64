// tee.hla64 - copy stdin bytes to stdout and argv[1] file (Linux SysV).
//
// Stress: stdin read, hlax_stdout_write + hlax_file_write dual sink.

program tee;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;
extern procedure hlax_file_open_write(path: cstring): int64;
extern procedure hlax_file_read(handle: int64; buffer: ptr; count: uint64): int64;
extern procedure hlax_file_write(handle: int64; buffer: ptr; count: uint64): int64;
extern procedure hlax_file_close(handle: int64): int64;
extern procedure hlax_stdout_write(buffer: ptr; count: uint64): int64;

static
    buffer: byte[256];
endstatic;

procedure TeeLoop(outHandle: int64); @returns("rax");
begin TeeLoop;
    mov(0, r13);
    while(r13 = 0) do
        call hlax_file_read(stdin_fd, &buffer, 256);
        if(rax < 0) then
            mov(-1, rax);
            mov(1, r13);
        else
            if(rax = 0) then
                mov(0, rax);
                mov(1, r13);
            else
                mov(rax, r12);
                call hlax_stdout_write(&buffer, r12);
                if(rax < 0) then
                    mov(-1, rax);
                    mov(1, r13);
                else
                    call hlax_file_write(outHandle, &buffer, r12);
                    if(rax < 0) then
                        mov(-1, rax);
                        mov(1, r13);
                    endif;
                endif;
            endif;
        endif;
    endwhile;
end TeeLoop;

begin tee;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("usage: tee <dst>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call hlax_file_open_write(r12);

        if(rax < 0) then
            stdout.put("open failed", nl);
            mov(1, rbx);
        else
            mov(rax, r15);
            call TeeLoop(r15);
            if(rax < 0) then
                stdout.put("io failed", nl);
                call hlax_file_close(r15);
                mov(1, rbx);
            else
                call hlax_file_close(r15);
                mov(0, rbx);
            endif;
        endif;
    endif;
end tee;
