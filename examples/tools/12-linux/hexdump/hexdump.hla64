// hexdump.hla64 - print a file as offset + hex bytes (argv[1]) (Linux SysV).
//
// Stress: hlax_file_* read loop, hex nibble formatting, while loop.

program hexdump;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;
extern procedure hlax_file_open_read(path: cstring): int64;
extern procedure hlax_file_read(handle: int64; buffer: ptr; count: uint64): int64;
extern procedure hlax_file_close(handle: int64): int64;

static
    buffer: byte[256];
endstatic;

procedure PrintHexNibble(n: int64); @returns("rax");
begin PrintHexNibble;
    if(n = 0) then stdout.put("0"); endif;
    if(n = 1) then stdout.put("1"); endif;
    if(n = 2) then stdout.put("2"); endif;
    if(n = 3) then stdout.put("3"); endif;
    if(n = 4) then stdout.put("4"); endif;
    if(n = 5) then stdout.put("5"); endif;
    if(n = 6) then stdout.put("6"); endif;
    if(n = 7) then stdout.put("7"); endif;
    if(n = 8) then stdout.put("8"); endif;
    if(n = 9) then stdout.put("9"); endif;
    if(n = 10) then stdout.put("a"); endif;
    if(n = 11) then stdout.put("b"); endif;
    if(n = 12) then stdout.put("c"); endif;
    if(n = 13) then stdout.put("d"); endif;
    if(n = 14) then stdout.put("e"); endif;
    if(n = 15) then stdout.put("f"); endif;
    mov(0, rax);
end PrintHexNibble;

procedure PrintHexByte(b: int64); @returns("rax");
begin PrintHexByte;
    mov(b, r15);
    mov(r15, r12);
    shr(4, r12);
    call PrintHexNibble(r12);
    mov(r15, r12);
    shr(4, r12);
    shl(4, r12);
    mov(r15, r11);
    sub(r12, r11);
    call PrintHexNibble(r11);
    mov(0, rax);
end PrintHexByte;

procedure DumpBuffer(n: int64); @returns("rax");
begin DumpBuffer;
    stdout.put("00000000  ");
    mov(&buffer, r14);
    mov(r14, r13);
    mov(n, r15);
    add(r15, r13);
    while(r14 < r13) do
        mov([r14].byte, r9);
        call PrintHexByte(r9);
        stdout.put(" ");
        add(1, r14);
    endwhile;
    stdout.put(nl);
    mov(0, rax);
end DumpBuffer;

begin hexdump;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("usage: hexdump <file>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call hlax_file_open_read(r12);

        if(rax < 0) then
            stdout.put("open failed", nl);
            mov(1, rbx);
        else
            mov(rax, r15);
            call hlax_file_read(r15, &buffer, 256);
            if(rax < 0) then
                stdout.put("read failed", nl);
                call hlax_file_close(r15);
                mov(1, rbx);
            else
                mov(rax, r10);
                call DumpBuffer(r10);
                call hlax_file_close(r15);
                mov(0, rbx);
            endif;
        endif;
    endif;
end hexdump;
