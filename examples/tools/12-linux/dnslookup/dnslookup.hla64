// dnslookup.hla64 - resolve host to IPv4 address.

program dnslookup;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;
extern procedure hlax_dns_resolve_v4(host: cstring; out_buf: ptr; capacity: uint64): int64;
extern procedure hlax_net_last_error(): int64;

static
    ipBuf: byte[64];
endstatic;

begin dnslookup;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("usage: dnslookup <host>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call hlax_dns_resolve_v4(r12, &ipBuf, 64);

        if(rax < 0) then
            call hlax_net_last_error();
            stdout.put("err=", rax, nl);
            mov(3, rbx);
        else
            stdout.put(&ipBuf, nl);
            mov(0, rbx);
        endif;
    endif;
end dnslookup;
