// filesize.hla64 - print the size of the file at argv[1] via hlax_file_size.

program filesize;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;
extern procedure hlax_file_size(path: cstring): int64;
extern procedure hlax_os_last_error(): int64;

begin filesize;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 2) then
        stdout.put("usage: filesize <file>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(1);
        mov(rax, r12);
        call hlax_file_size(r12);

        if(rax < 0) then
            call hlax_os_last_error();
            stdout.put("err=", rax, nl);
            mov(2, rbx);
        else
            stdout.put("bytes: ", rax, nl);
            mov(0, rbx);
        endif;
    endif;
end filesize;
