// grep.hla64 - print lines equal to argv[2] literal in argv[1] (Linux SysV).
//
// MVP: whole-line fixed-string match (not substring). Stress: line buffer, hlax_strlen.

program grep;

#include("stdlib64.hhf")

extern procedure hlax_argv_init(): int64;
extern procedure hlax_argv_count(): int64;
extern procedure hlax_argv_get(index:int64): ptr;
extern procedure hlax_file_open_read(path: cstring): int64;
extern procedure hlax_file_read(handle: int64; buffer: ptr; count: uint64): int64;
extern procedure hlax_file_close(handle: int64): int64;
extern procedure hlax_stdout_write(buffer: ptr; count: uint64): int64;
extern procedure hlax_strlen(buf: cstring): uint64;

static
    buffer: byte[256];
    line: byte[128];
    lineLen: int64;
    nlByte: byte := 10;
endstatic;

procedure ResetLine(); @returns("rax");
begin ResetLine;
    mov(0, lineLen);
    mov(0, rax);
end ResetLine;

procedure AppendByte(b: int64); @returns("rax");
begin AppendByte;
    if(lineLen < 127) then
        mov(&line, r10);
        mov(lineLen, r11);
        add(r11, r10);
        mov(b, [r10].byte);
        add(1, lineLen);
    endif;
    mov(0, rax);
end AppendByte;

procedure LineMatches(needle: ptr; needleLen: int64); @returns("rax");
begin LineMatches;
    mov(needleLen, r10);
    mov(0, rax);
    if(lineLen != r10) then
        mov(rax, rax);
    else
        mov(&line, r14);
        mov(needle, r15);
        mov(lineLen, r8);
        while(r8 > 0) do
            mov([r14].byte, r10);
            mov([r15].byte, r11);
            if(r10 != r11) then
                mov(0, r8);
                mov(0, rax);
            else
                add(1, r14);
                add(1, r15);
                sub(1, r8);
                if(r8 = 0) then
                    mov(1, rax);
                endif;
            endif;
        endwhile;
    endif;
end LineMatches;

procedure EmitLine(); @returns("rax");
begin EmitLine;
    if(lineLen > 0) then
        call hlax_stdout_write(&line, lineLen);
        call hlax_stdout_write(&nlByte, 1);
    endif;
    mov(0, rax);
end EmitLine;

procedure TryEmitLine(needle: ptr; needleLen: int64); @returns("rax");
begin TryEmitLine;
    call LineMatches(needle, needleLen);
    if(rax != 0) then
        call EmitLine();
    endif;
    call ResetLine();
    mov(0, rax);
end TryEmitLine;

procedure ProcessByte(b: int64; needle: ptr; needleLen: int64); @returns("rax");
begin ProcessByte;
    if(b = 10) then
        call TryEmitLine(needle, needleLen);
    else
        call AppendByte(b);
    endif;
    mov(0, rax);
end ProcessByte;

procedure ProcessBuffer(n: int64; needle: ptr; needleLen: int64); @returns("rax");
begin ProcessBuffer;
    mov(0, r12);
    mov(n, r13);
    while(r12 < r13) do
        mov(&buffer, r14);
        add(r12, r14);
        mov([r14].byte, r9);
        call ProcessByte(r9, needle, needleLen);
        add(1, r12);
    endwhile;
    mov(0, rax);
end ProcessBuffer;

procedure GrepLoop(handle: int64; needle: ptr; needleLen: int64); @returns("rax");
begin GrepLoop;
    call ResetLine();
    mov(0, r13);
    while(r13 = 0) do
        call hlax_file_read(handle, &buffer, 256);
        if(rax < 0) then
            mov(-1, rax);
            mov(1, r13);
        else
            if(rax = 0) then
                call TryEmitLine(needle, needleLen);
                mov(0, rax);
                mov(1, r13);
            else
                mov(rax, r12);
                call ProcessBuffer(r12, needle, needleLen);
            endif;
        endif;
    endwhile;
end GrepLoop;

begin grep;
    call hlax_argv_init();
    call hlax_argv_count();

    if(rax < 3) then
        stdout.put("usage: grep <file> <literal>", nl);
        mov(1, rbx);
    else
        call hlax_argv_get(2);
        mov(rax, r12);
        call hlax_strlen(r12);
        mov(rax, r13);
        call hlax_argv_get(1);
        mov(rax, r12);
        call hlax_file_open_read(r12);

        if(rax < 0) then
            stdout.put("open failed", nl);
            mov(1, rbx);
        else
            mov(rax, r15);
            call hlax_argv_get(2);
            mov(rax, r14);
            call GrepLoop(r15, r14, r13);
            if(rax < 0) then
                stdout.put("read failed", nl);
                call hlax_file_close(r15);
                mov(1, rbx);
            else
                call hlax_file_close(r15);
                mov(0, rbx);
            endif;
        endif;
    endif;
end grep;
