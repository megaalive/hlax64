// exists.hla64 - return 0 when a known fixture exists, 1 otherwise.
//
// Stress: minimal Win32 interop, branch, process exit code.

program exists;

#include("stdlib64.hhf")

extern procedure GetFileAttributesA(lpFileName: cstring): uint64 from "kernel32.dll";

begin exists;
    // Hardcoded fixture path until argv lands (see 10-real-tools/README.md).
    call GetFileAttributesA(&"examples\\10-real-tools\\exists\\fixtures\\sample-a.txt");

    if(rax = -1) then
        stdout.put("missing", nl);
        mov(1, rax);
    else
        stdout.put("exists", nl);
        mov(0, rax);
    endif;
end exists;
