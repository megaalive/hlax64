// fnv1a.hla64 - FNV-1a 64-bit hash of a small fixture file.
//
// Stress: imul/xor in a hot loop, 64-bit constants, file read, integer stdout.
// Expected hash for fixtures/sample-a.txt verified against a C# baseline.

program fnv1a;

#include("stdlib64.hhf")

extern procedure CreateFileA(lpFileName: cstring; dwDesiredAccess: uint64; dwShareMode: uint64; lpSecurityAttributes: ptr; dwCreationDisposition: uint64; dwFlagsAndAttributes: uint64; hTemplateFile: uint64): int64 from "kernel32.dll";
extern procedure ReadFile(hFile: int64; lpBuffer: ptr; nNumberOfBytesToRead: uint64; lpNumberOfBytesRead: ptr; lpOverlapped: ptr): int32 from "kernel32.dll";
extern procedure CloseHandle(hObject: int64): int32 from "kernel32.dll";

static
    buffer: byte[256];
    bytesRead: int64;
endstatic;

const
    FnvOffset := $cbf29ce484222325;
    FnvPrime  := $100000001b3;
endconst;

procedure HashBuffer(n: int64); @returns("rax");
begin HashBuffer;
    mov(FnvOffset, r11);
    mov(0, r8);
    mov(n, r15);
    mov(&buffer, r14);

    while(r8 < r15) do
        mov([r14].byte, r9);
        xor(r9, r11);
        mov(FnvPrime, rax);
        imul(rax, r11);
        add(1, r8);
        add(1, r14);
    endwhile;

    mov(r11, rax);
end HashBuffer;

begin fnv1a;
    call CreateFileA(&"examples\\10-real-tools\\fnv1a\\fixtures\\sample-a.txt", 2147483648, 1, 0, 3, 128, 0);

    if(rax = -1) then
        stdout.put("open failed", nl);
        mov(1, rax);
    else
        mov(rax, r15);
        call ReadFile(r15, &buffer, 256, &bytesRead, 0);
        if(rax = 0) then
            stdout.put("read failed", nl);
            call CloseHandle(r15);
            mov(1, rax);
        else
            mov(bytesRead, r10);
            call HashBuffer(r10);
            mov(rax, r12);
            stdout.put("fnv1a=", r12, nl);
            call CloseHandle(r15);
            mov(0, rax);
        endif;
    endif;
end fnv1a;
