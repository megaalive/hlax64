program six_args;

#include("stdlib64.hhf")

procedure Sum6(a:int64; b:int64; c:int64; d:int64; e:int64; f:int64); @returns("rax");
begin Sum6;
    mov(a, rax);
    add(b, rax);
    add(c, rax);
    add(d, rax);
    add(e, rax);
    add(f, rax);
end Sum6;

begin six_args;
    call Sum6(1, 2, 3, 4, 5, 6);
    stdout.put("1+2+3+4+5+6 = ", rax, nl);
end six_args;
