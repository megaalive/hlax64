// Level 3: string length via hlax_strlen runtime helper
program string_length;

#include("stdlib64.hhf")

extern procedure hlax_strlen(buf: cstring): uint64;

procedure StrLen; @returns("rax");
begin StrLen;
    mov(&"hello", rcx);
    call hlax_strlen(rcx);
end StrLen;

begin string_length;
    call StrLen();
    mov(rax, rbx);
end string_length;
