// euler010-sum-primes-below-2m.hla64 — PE #10 (142913828902)

program euler010;

#include("stdlib64.hhf")

static
    composite: int64[2000001];
endstatic;

begin euler010;
    mov(0, r12);
    mov(2000001, r13);

    while(r12 < r13) do
        mov(0, rax);
        mov(r12, r11);
        mov(rax, composite[r11]);
        add(1, r12);
    endwhile;

    mov(2, r14);
    mov(2000001, rbx);

    while(r14 < rbx) do
        mov(r14, r11);
        mov(composite[r11], r12);

        if(r12 = 0) then
            mov(r14, r11);
            imul(r14, r11);
            mov(r11, r15);

            while(r15 < rbx) do
                mov(1, rax);
                mov(r15, r10);
                mov(rax, composite[r10]);
                mov(r14, r11);
                add(r11, r15);
            endwhile;

            add(1, r14);
        else
            add(1, r14);
        endif;
    endwhile;

    mov(0, r12);
    mov(2, r13);
    mov(2000000, rbx);

    while(r13 < rbx) do
        mov(r13, r11);
        mov(composite[r11], r10);

        if(r10 = 0) then
            mov(r12, r11);
            add(r13, r11);
            mov(r11, r12);
        endif;

        add(1, r13);
    endwhile;

    stdout.put("Euler #10 = ", r12, nl);
end euler010;
