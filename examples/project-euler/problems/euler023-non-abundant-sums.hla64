// euler023-non-abundant-sums.hla64 — PE #23 (4179871)

program euler023;

#include("stdlib64.hhf")

static
    abundant: int64[28124];
    expressible: int64[28124];
endstatic;

begin euler023;
    mov(0, r12);
    mov(28124, r13);

    while(r12 < r13) do
        mov(0, rax);
        mov(r12, r11);
        mov(rax, abundant[r11]);
        mov(rax, expressible[r11]);
        add(1, r12);
    endwhile;

    mov(1, r13);
    mov(28124, rbx);

    while(r13 < rbx) do
        mov(1, r14);
        mov(2, r15);
        mov(r13, r10);

        while(r15 < r10) do
            mov(r15, r11);
            imul(r11, r11);
            if(r11 > r10) then
                mov(r10, r15);
            else
                mov(r13, rax);
                mov(r15, r11);
                mod(r11, rax);
                if(rax = 0) then
                    mov(r15, r11);
                    mov(r14, rax);
                    add(r11, rax);
                    mov(rax, r14);
                    mov(r15, r11);
                    imul(r11, r11);
                    mov(r13, rax);
                    if(r11 < rax) then
                        mov(r13, rax);
                        mov(r15, r11);
                        idiv(r11, rax);
                        mov(r14, r11);
                        add(rax, r11);
                        mov(r11, r14);
                    endif;
                endif;
                add(1, r15);
            endif;
        endwhile;

        if(r14 >? r13) then
            mov(1, rax);
            mov(r13, r11);
            mov(rax, abundant[r11]);
        endif;
        add(1, r13);
    endwhile;

    mov(1, r13);
    while(r13 < rbx) do
        mov(r13, r11);
        mov(abundant[r11], r14);
        if(r14 > 0) then
            mov(1, r15);
            while(r15 < rbx) do
                mov(r15, r11);
                mov(abundant[r11], r10);
                if(r10 > 0) then
                    mov(r13, r11);
                    add(r15, r11);
                    if(r11 < rbx) then
                        mov(1, rax);
                        mov(r11, r10);
                        mov(rax, expressible[r10]);
                    endif;
                endif;
                add(1, r15);
            endwhile;
        endif;
        add(1, r13);
    endwhile;

    mov(0, r12);
    mov(1, r13);
    while(r13 < rbx) do
        mov(r13, r11);
        mov(expressible[r11], r10);
        if(r10 = 0) then
            mov(r12, r11);
            add(r13, r11);
            mov(r11, r12);
        endif;
        add(1, r13);
    endwhile;

    stdout.put("Euler #23 = ", r12, nl);
end euler023;
