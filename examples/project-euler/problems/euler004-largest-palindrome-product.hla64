// euler004-largest-palindrome-product.hla64 — PE #4 (906609)

program euler004;

#include("stdlib64.hhf")

begin euler004;
    mov(0, r12);
    mov(999, r13);

    while(r13 > 99) do
        mov(r13, r14);

        while(r14 > 99) do
            mov(r13, rax);
            imul(r14, rax);
            mov(rax, r15);

            mov(r15, r11);
            mov(0, r10);

            while(r11 > 0) do
                mov(r11, rax);
                mov(10, r9);
                mod(r9, rax);
                mov(10, r9);
                imul(r9, r10);
                add(rax, r10);
                mov(r11, rax);
                mov(10, r9);
                idiv(r9, rax);
                mov(rax, r11);
            endwhile;

            mov(r10, rax);
            mov(r15, r11);
            if(rax = r11) then
                if(r15 > r12) then
                    mov(r15, r12);
                endif;
            endif;

            sub(1, r14);
        endwhile;

        sub(1, r13);
    endwhile;

    stdout.put("Euler #4 = ", r12, nl);
end euler004;
