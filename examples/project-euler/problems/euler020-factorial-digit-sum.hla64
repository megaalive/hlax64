// euler020-factorial-digit-sum.hla64 — PE #20 (648)

program euler020;

#include("stdlib64.hhf")

static
    digits: int64[1000];
endstatic;

begin euler020;
    mov(1, digits[0]);
    mov(1, r12);
    mov(2, r13);
    mov(101, r9);

    while(r13 < r9) do
        mov(0, r14);
        mov(0, r15);

        while(r15 < r12) do
            mov(digits[r15], rax);
            imul(r13, rax);
            add(r14, rax);
            mov(rax, r10);
            mov(10, r8);
            mod(r8, rax);
            mov(rax, digits[r15]);
            mov(r10, rax);
            mov(10, r8);
            idiv(r8, rax);
            mov(rax, r14);
            add(1, r15);
        endwhile;

        if(r14 > 0) then
            while(r14 > 0) do
                mov(r14, r10);
                mov(r10, rax);
                mov(10, r8);
                mod(r8, rax);
                mov(rax, digits[r12]);
                mov(r14, r10);
                mov(r10, rax);
                mov(10, r8);
                idiv(r8, rax);
                mov(rax, r14);
                add(1, r12);
            endwhile;
        endif;

        add(1, r13);
    endwhile;

    mov(0, r14);
    mov(0, r13);

    while(r13 < r12) do
        mov(digits[r13], r11);
        add(r11, r14);
        add(1, r13);
    endwhile;

    stdout.put("Euler #20 = ", r14, nl);
end euler020;
