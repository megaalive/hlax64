// euler016-power-digit-sum.hla64 — PE #16 (1366)

program euler016;

#include("stdlib64.hhf")

static
    digits: int64[400];
endstatic;

begin euler016;
    mov(1, digits[0]);
    mov(1, r12);
    mov(0, r13);

    while(r13 < 1000) do
        mov(0, r14);
        mov(0, r15);

        while(r15 < r12) do
            mov(digits[r15], rax);
            mov(2, r10);
            imul(r10, rax);
            add(r14, rax);
            mov(rax, r10);
            mov(10, r8);
            mod(r8, rax);
            mov(rax, digits[r15]);
            mov(r10, rax);
            mov(10, r8);
            idiv(r8, rax);
            mov(rax, r14);
            add(1, r15);
        endwhile;

        if(r14 > 0) then
            mov(r14, r10);
            mov(r10, rax);
            mov(10, r8);
            mod(r8, rax);
            mov(rax, digits[r12]);
            mov(r10, rax);
            mov(10, r8);
            idiv(r8, rax);
            mov(rax, r14);
            add(1, r12);
        endif;

        add(1, r13);
    endwhile;

    mov(0, r14);
    mov(0, r13);

    while(r13 < r12) do
        mov(digits[r13], r11);
        add(r11, r14);
        add(1, r13);
    endwhile;

    stdout.put("Euler #16 = ", r14, nl);
end euler016;
