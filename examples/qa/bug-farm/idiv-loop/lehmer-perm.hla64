// lehmer-perm.hla64 — full millionth permutation via Lehmer (PE #24 style).
// Exit code = last 8 digits mod 1000 of 2783915460 → 460 (or use stdout for full value).
// We accumulate r13 like euler024; expected r13 mod 100000 = 15460 → use exit r13 mod 256 = 100? 
// Simpler check: sum idx = 26 (same as lehmer-indices) embedded in full perm build.

program lehmer_perm;

#include("stdlib64.hhf")

static
    pool: int64[10];
    idx: int64[10];
    facts: int64[10];
    used: int64[10];
endstatic;

begin lehmer_perm;
    mov(0, pool[0]);
    mov(1, pool[1]);
    mov(2, pool[2]);
    mov(3, pool[3]);
    mov(4, pool[4]);
    mov(5, pool[5]);
    mov(6, pool[6]);
    mov(7, pool[7]);
    mov(8, pool[8]);
    mov(9, pool[9]);

    mov(1, facts[0]);
    mov(1, r11);
    mov(1, r10);
    while(r10 < 10) do
        mov(r11, facts[r10]);
        mov(r10, rax);
        add(1, rax);
        imul(rax, r11);
        add(1, r10);
    endwhile;

    mov(999999, r12);
    mov(9, r14);
    while(r14 > -1) do
        mov(r14, r11);
        mov(facts[r11], r11);
        mov(r12, rax);
        idiv(r11, rax);
        mov(r14, r11);
        mov(rax, idx[r11]);
        mov(r12, rax);
        mod(r11, rax);
        mov(rax, r12);
        if(r14 = 0) then
            mov(-1, r14);
        else
            sub(1, r14);
        endif;
    endwhile;

    mov(0, used[0]);
    mov(0, used[1]);
    mov(0, used[2]);
    mov(0, used[3]);
    mov(0, used[4]);
    mov(0, used[5]);
    mov(0, used[6]);
    mov(0, used[7]);
    mov(0, used[8]);
    mov(0, used[9]);

    mov(0, r13);
    mov(9, r14);
    mov(1000, r9);

    while(r14 < r9) do
        mov(r14, r11);
        mov(idx[r11], r10);

        mov(0, rbx);
        mov(0, r15);
        mov(10, r8);

        while(r15 < r8) do
            mov(r15, r11);
            mov(used[r11], rax);
            if(rax = 0) then
                if(rbx = r10) then
                    mov(r15, r8);
                    mov(pool[r8], r11);
                    mov(r13, rax);
                    mov(10, r15);
                    imul(r15, rax);
                    add(r11, rax);
                    mov(rax, r13);
                    mov(1, rax);
                    mov(rax, used[r8]);
                    mov(10, r15);
                else
                    add(1, rbx);
                endif;
            endif;
            add(1, r15);
        endwhile;

        if(r14 = 0) then
            mov(r9, r14);
        else
            sub(1, r14);
        endif;
    endwhile;

    mov(r13, rbx);
end lehmer_perm;
