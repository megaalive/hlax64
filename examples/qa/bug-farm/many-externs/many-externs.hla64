// many-externs.hla64 - multiple Win32 import declarations and calls.
program many_externs;

extern procedure GetCommandLineA(): ptr from "kernel32.dll";
extern procedure GetModuleHandleA(hModule: ptr): int64 from "kernel32.dll";
extern procedure GetLastError(): int32 from "kernel32.dll";
extern procedure SetLastError(dwErrCode: uint32): int64 from "kernel32.dll";
extern procedure CloseHandle(hObject: int64): int32 from "kernel32.dll";
extern procedure GetCurrentProcess(): int64 from "kernel32.dll";
extern procedure GetTickCount(): uint32 from "kernel32.dll";

begin many_externs;
    call GetCommandLineA();
    call GetModuleHandleA(0);
    call GetLastError();
    call SetLastError(0);
    call GetCurrentProcess();
    call GetTickCount();
    mov(0, rbx);
end many_externs;
