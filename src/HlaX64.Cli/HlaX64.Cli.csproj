<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HlaX64.Compiler\HlaX64.Compiler.csproj" />
    <ProjectReference Include="..\HlaX64.Backend.Nasm\HlaX64.Backend.Nasm.csproj" />
    <ProjectReference Include="..\HlaX64.DebugAdapter\HlaX64.DebugAdapter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>hla64</ToolCommandName>
    <PackageId>HlaX64.Cli</PackageId>
    <Version>0.2.0-alpha</Version>
    <Authors>megaalive</Authors>
    <Description>AI-friendly HLA-inspired x64 compiler CLI for verified native code.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/megaalive/hlax64</PackageProjectUrl>
    <RepositoryUrl>https://github.com/megaalive/hlax64</RepositoryUrl>
  </PropertyGroup>

</Project>
