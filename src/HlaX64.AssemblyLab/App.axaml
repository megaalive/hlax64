<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HlaX64.AssemblyLab.App"
             xmlns:local="using:HlaX64.AssemblyLab"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>

        <!-- Window -->
        <Style Selector="Window">
            <Setter Property="Background" Value="#1e1e1e"/>
        </Style>

        <!-- Menu -->
        <Style Selector="Menu">
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#094771"/>
        </Style>
        <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#094771"/>
        </Style>

        <!-- Toolbar: plain button -->
        <Style Selector="Button.toolbar-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.toolbar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2a2d2e"/>
        </Style>
        <Style Selector="Button.toolbar-btn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#094771"/>
        </Style>
        <Style Selector="Button.toolbar-btn:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.38"/>
        </Style>

        <!-- Toolbar: accent (Run / Build / Debug) -->
        <Style Selector="Button.toolbar-accent">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#4ec9b0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.toolbar-accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1b3430"/>
        </Style>
        <Style Selector="Button.toolbar-accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2d5a47"/>
        </Style>
        <Style Selector="Button.toolbar-accent:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.38"/>
        </Style>

        <!-- Toolbar: danger (Stop) -->
        <Style Selector="Button.toolbar-danger">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#f44747"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.toolbar-danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3a1a1a"/>
        </Style>
        <Style Selector="Button.toolbar-danger:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.38"/>
        </Style>

        <!-- Toolbar group label -->
        <Style Selector="TextBlock.toolbar-group-label">
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,3,0"/>
        </Style>

        <!-- Sidebar section header -->
        <Style Selector="TextBlock.section-header">
            <Setter Property="Foreground" Value="#aaaaaa"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Vertical separator in toolbar -->
        <Style Selector="Rectangle.v-sep">
            <Setter Property="Fill" Value="#3a3a3a"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

        <!-- TabControl / TabItem -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="Foreground" Value="#969696"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="#ffffff"/>
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#2a2d2e"/>
        </Style>

        <!-- ListBox (Diagnostics) -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Foreground" Value="#d4d4d4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#094771"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2a2d2e"/>
        </Style>

        <!-- Output TextBox panels -->
        <Style Selector="TextBox.output-panel">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="#d4d4d4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="#aeafad"/>
            <Setter Property="SelectionBrush" Value="#264f78"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="Cascadia Code,Consolas,Courier New,monospace"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ComboBox -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#094771"/>
        </Style>

        <!-- CheckBox -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#cccccc"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

    </Application.Styles>
</Application>
