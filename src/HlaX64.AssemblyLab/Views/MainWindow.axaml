<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HlaX64.AssemblyLab.ViewModels"
        xmlns:models="using:HlaX64.AssemblyLab.Models"
        xmlns:controls="using:HlaX64.AssemblyLab.Controls"
        xmlns:avaloniaEdit="using:AvaloniaEdit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="840"
        x:Class="HlaX64.AssemblyLab.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="HlaX64 Assembly Lab"
        Width="1280" Height="840"
        Background="#1e1e1e"
        x:Name="RootWindow">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>

        <!-- MENU BAR -->
        <Menu DockPanel.Dock="Top" Background="#3c3c3c">
            <MenuItem Header="_File">
                <MenuItem Header="Open File..."    Command="{Binding OpenFileCommand}"/>
                <MenuItem Header="Open Project..." Command="{Binding OpenProjectCommand}"/>
                <Separator/>
                <MenuItem Header="Save"            Command="{Binding SaveFileCommand}" InputGesture="Ctrl+S"/>
                <MenuItem Header="Save As..."      Command="{Binding SaveFileAsCommand}"/>
            </MenuItem>
            <MenuItem Header="_Build" Command="{Binding BuildCommand}"/>
            <MenuItem Header="_Run"   Command="{Binding RunCommand}"/>
            <MenuItem Header="_Debug" Command="{Binding DebugCommand}"
                      IsEnabled="{Binding IsDebugFeatureEnabled}"
                      ToolTip.Tip="{Binding DebugFeatureDisabledHint}"/>
            <MenuItem Header="Export _Proof Bundle" Command="{Binding ExportProofBundleCommand}"/>
        </Menu>

        <!-- TOOLBAR -->
        <Border DockPanel.Dock="Top"
                Background="#252526"
                BorderBrush="#1a1a1a"
                BorderThickness="0,0,0,1"
                Padding="6,3">
            <StackPanel Spacing="3">

                <!-- Row 1: File · Build · Run/Debug · Export -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">

                    <TextBlock Classes="toolbar-group-label" Text="FILE"/>
                    <Button Classes="toolbar-btn" Content="Open File"    Command="{Binding OpenFileCommand}"       ToolTip.Tip="Open File"/>
                    <Button Classes="toolbar-btn" Content="Open Project" Command="{Binding OpenProjectCommand}"    ToolTip.Tip="Open Project"/>
                    <Button Classes="toolbar-btn" Content="Save"         Command="{Binding SaveFileCommand}"       ToolTip.Tip="Save  Ctrl+S"/>
                    <Button Classes="toolbar-btn" Content="Build Folder" Command="{Binding OpenBuildFolderCommand}" ToolTip.Tip="Open build output folder"/>

                    <Rectangle Classes="v-sep"/>

                    <TextBlock Classes="toolbar-group-label" Text="BUILD"/>
                    <Button Classes="toolbar-accent" Content="Build" Command="{Binding BuildCommand}" ToolTip.Tip="Build"/>

                    <Rectangle Classes="v-sep"/>

                    <TextBlock Classes="toolbar-group-label" Text="RUN"/>
                    <Button Classes="toolbar-accent" Content="Run"   Command="{Binding RunCommand}"   ToolTip.Tip="Run"/>
                    <Button Classes="toolbar-accent" Content="Debug" Command="{Binding DebugCommand}"
                            IsEnabled="{Binding IsDebugFeatureEnabled}"
                            ToolTip.Tip="{Binding DebugFeatureDisabledHint}"/>

                    <Rectangle Classes="v-sep"/>

                    <TextBlock Classes="toolbar-group-label" Text="DEBUG"/>
                    <Button Classes="toolbar-btn"    Content="Continue"  Command="{Binding DebugContinueCommand}" ToolTip.Tip="Continue  F5"/>
                    <Button Classes="toolbar-btn"    Content="Step Over" Command="{Binding DebugStepOverCommand}" ToolTip.Tip="Step Over  F10"/>
                    <Button Classes="toolbar-btn"    Content="Step Into" Command="{Binding DebugStepIntoCommand}" ToolTip.Tip="Step Into  F11"/>
                    <Button Classes="toolbar-btn"    Content="Step Out"  Command="{Binding DebugStepOutCommand}"  ToolTip.Tip="Step Out  Shift+F11"/>
                    <Button Classes="toolbar-danger" Content="Stop"      Command="{Binding DebugStopCommand}"     ToolTip.Tip="Stop debugging"/>

                    <Rectangle Classes="v-sep"/>

                    <Button Classes="toolbar-btn" Content="Proof Bundle" Command="{Binding ExportProofBundleCommand}" ToolTip.Tip="Export proof bundle"/>
                </StackPanel>

                <!-- Row 2: Tools · MCP · Options · Target -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">

                    <TextBlock Classes="toolbar-group-label" Text="AI"/>
                    <Button Classes="toolbar-btn" Content="Explain"   Command="{Binding ExplainRepairCommand}"    ToolTip.Tip="Explain and suggest repair"/>
                    <Button Classes="toolbar-btn" Content="Apply Fix" Command="{Binding ApplySuggestedFixCommand}" ToolTip.Tip="Apply suggested fix"/>

                    <Rectangle Classes="v-sep"/>

                    <TextBlock Classes="toolbar-group-label" Text="MCP"/>
                    <Button Classes="toolbar-btn" Content="Start"
                            Command="{Binding StartMcpCommand}"
                            IsEnabled="{Binding IsMcpFeatureEnabled}"
                            ToolTip.Tip="{Binding McpFeatureDisabledHint}"/>
                    <Button Classes="toolbar-btn" Content="Tools"
                            Command="{Binding ListMcpToolsCommand}"
                            IsEnabled="{Binding IsMcpFeatureEnabled}"
                            ToolTip.Tip="List MCP tools"/>
                    <Button Classes="toolbar-btn" Content="Explain"
                            Command="{Binding McpExplainCommand}"
                            IsEnabled="{Binding IsMcpFeatureEnabled}"
                            ToolTip.Tip="MCP explain"/>

                    <Rectangle Classes="v-sep"/>

                    <TextBlock Classes="toolbar-group-label" Text="OPTIONS"/>
                    <CheckBox Content="Strict plan gate"
                              IsChecked="{Binding StrictPlanGate}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="When ON, Build/Run/Proof require Plan approved after each edit."/>
                    <CheckBox Content="Plan approved"
                              IsChecked="{Binding PlanApproved}"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Required only when Strict plan gate is enabled."/>

                    <Rectangle Classes="v-sep"/>

                    <TextBlock Classes="toolbar-group-label" Text="TARGET"/>
                    <ComboBox MinWidth="180"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding TargetChoices}"
                              SelectedItem="{Binding SelectedTarget}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- STATUS BAR -->
        <Border DockPanel.Dock="Bottom"
                Background="#007acc"
                Height="22"
                Padding="10,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding OpenModeText}"
                           Foreground="White"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding BuildOutputDir}"
                           Foreground="#c8e6fa"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Opacity="0.9"/>
            </Grid>
        </Border>

        <!-- MAIN AREA -->
        <Grid ColumnDefinitions="240,4,*" RowDefinitions="*,4,180">

            <!-- Sidebar: Diagnostics -->
            <Border Grid.Row="0" Grid.Column="0"
                    Background="#252526"
                    BorderBrush="#1a1a1a"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="#252526"
                            BorderBrush="#333"
                            BorderThickness="0,0,0,1"
                            Padding="8,5">
                        <TextBlock Text="DIAGNOSTICS" Classes="section-header" Margin="0"/>
                    </Border>
                    <ListBox x:Name="diagList"
                             ItemsSource="{Binding Diagnostics}"
                             DoubleTapped="Diagnostics_DoubleTapped"
                             Background="#252526">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:LabDiagnosticItem">
                                <TextBlock Text="{Binding Display}"
                                           TextWrapping="Wrap"
                                           FontFamily="Cascadia Code,Consolas,monospace"
                                           FontSize="11"
                                           Foreground="#d4d4d4"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Vertical splitter -->
            <GridSplitter Grid.Row="0" Grid.Column="1"
                          Background="#1a1a1a"
                          ResizeDirection="Columns"/>

            <!-- Editor tabs -->
            <TabControl Grid.Row="0" Grid.Column="2"
                        SelectedIndex="{Binding SelectedTabIndex}"
                        Background="#1e1e1e"
                        Padding="0">
                <TabItem Header="Source">
                    <avaloniaEdit:TextEditor x:Name="SourceEditor" Background="#1e1e1e"/>
                </TabItem>
                <TabItem Header="IR">
                    <avaloniaEdit:TextEditor x:Name="IrEditor" Background="#1e1e1e"/>
                </TabItem>
                <TabItem Header="NASM">
                    <avaloniaEdit:TextEditor x:Name="NasmEditor" Background="#1e1e1e"/>
                </TabItem>
                <TabItem Header="ABI">
                    <avaloniaEdit:TextEditor x:Name="AbiEditor" Background="#1e1e1e"/>
                </TabItem>
                <TabItem Header="Disasm">
                    <avaloniaEdit:TextEditor x:Name="DisasmEditor" Background="#1e1e1e"/>
                </TabItem>
            </TabControl>

            <!-- Horizontal splitter -->
            <GridSplitter Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                          Background="#1a1a1a"
                          ResizeDirection="Rows"/>

            <!-- Bottom panel: output tabs -->
            <TabControl x:Name="BottomTabControl" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="#1e1e1e"
                        Padding="0"
                        SelectedIndex="{Binding SelectedBottomTabIndex}">
                <TabItem Header="Output">
                    <ScrollViewer Background="#1e1e1e">
                        <TextBox Classes="output-panel" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Text="{Binding OutputText}"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Terminal">
                    <DockPanel Background="#1e1e1e">
                        <Border DockPanel.Dock="Top"
                                Background="#252526"
                                BorderBrush="#333333"
                                BorderThickness="0,0,0,1"
                                Padding="4,3">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Classes="toolbar-btn" Content="Build"   Command="{Binding TerminalPresetBuildCommand}"  ToolTip.Tip="Inject hla64 build for current file"/>
                                <Button Classes="toolbar-btn" Content="Run"     Command="{Binding TerminalPresetRunCommand}"    ToolTip.Tip="Inject hla64 run for current file"/>
                                <Button Classes="toolbar-btn" Content="Doctor"  Command="{Binding TerminalPresetDoctorCommand}" ToolTip.Tip="Inject hla64 doctor"/>
                                <Button Classes="toolbar-btn" Content="Restart" Command="{Binding TerminalRestartCommand}"      ToolTip.Tip="Restart interactive shell"/>
                                <Button Classes="toolbar-btn" Content="Stop"    Command="{Binding TerminalStopShellCommand}"    ToolTip.Tip="Stop shell process"/>
                            </StackPanel>
                        </Border>
                        <controls:LabTerminalControl x:Name="LabTerminal"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="DAP">
                    <ScrollViewer Background="#1e1e1e">
                        <TextBox Classes="output-panel" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Text="{Binding DapText}"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Capabilities">
                    <ScrollViewer Background="#1e1e1e">
                        <TextBox Classes="output-panel" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Text="{Binding CapabilitiesText}"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Toolchain">
                    <ScrollViewer Background="#1e1e1e">
                        <TextBox Classes="output-panel" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Text="{Binding ToolchainText}"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Settings">
                    <Grid Background="#1e1e1e"
                          ColumnDefinitions="Auto,*,Auto"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
                          Margin="8"
                          RowSpacing="6"
                          ColumnSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="TOOLCHAIN SETTINGS"
                                   Classes="section-header"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="hla64 CLI" Foreground="#cccccc" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Classes="terminal-command" Text="{Binding SettingsHla64Path}" Watermark="Auto / bundled / PATH"/>
                        <Button Grid.Row="1" Grid.Column="2" Classes="toolbar-btn" Content="Browse" Command="{Binding BrowseHla64PathCommand}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Runtime directory" Foreground="#cccccc" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Classes="terminal-command" Text="{Binding SettingsRuntimeDirectory}" Watermark="runtime folder or HLAX64_RUNTIME_DIR"/>
                        <Button Grid.Row="2" Grid.Column="2" Classes="toolbar-btn" Content="Browse" Command="{Binding BrowseRuntimeDirectoryCommand}"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="NASM" Foreground="#cccccc" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Classes="terminal-command" Text="{Binding SettingsNasmPath}" Watermark="nasm executable"/>
                        <Button Grid.Row="3" Grid.Column="2" Classes="toolbar-btn" Content="Browse" Command="{Binding BrowseNasmPathCommand}"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Windows linker" Foreground="#cccccc" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Classes="terminal-command" Text="{Binding SettingsWindowsLinkerPath}" Watermark="lld-link or link.exe"/>
                        <Button Grid.Row="4" Grid.Column="2" Classes="toolbar-btn" Content="Browse" Command="{Binding BrowseWindowsLinkerPathCommand}"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Linux linker" Foreground="#cccccc" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Classes="terminal-command" Text="{Binding SettingsLinuxLinkerPath}" Watermark="gcc / ld / WSL auto"/>
                        <Button Grid.Row="5" Grid.Column="2" Classes="toolbar-btn" Content="Browse" Command="{Binding BrowseLinuxLinkerPathCommand}"/>

                        <DockPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,2,0,6">
                                <Button Classes="toolbar-accent" Content="Auto Detect" Command="{Binding AutoDetectToolchainCommand}"/>
                                <Button Classes="toolbar-accent" Content="Test" Command="{Binding TestToolchainSettingsCommand}"/>
                                <Button Classes="toolbar-btn" Content="Save" Command="{Binding SaveToolchainSettingsCommand}"/>
                                <Button Classes="toolbar-danger" Content="Reset" Command="{Binding ResetToolchainSettingsCommand}"/>
                            </StackPanel>
                            <ScrollViewer>
                                <TextBox Classes="output-panel" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" Text="{Binding SettingsStatusText}"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Agent">
                    <ScrollViewer Background="#1e1e1e">
                        <TextBox Classes="output-panel" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Text="{Binding AgentText}"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="MCP">
                    <ScrollViewer Background="#1e1e1e">
                        <TextBox Classes="output-panel" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Text="{Binding McpText}"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Plan">
                    <ScrollViewer Background="#1e1e1e">
                        <TextBox Classes="output-panel" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Text="{Binding PlanText}"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Diff">
                    <ScrollViewer Background="#1e1e1e">
                        <TextBox Classes="output-panel" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" Text="{Binding DiffText}"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

        </Grid>

    </DockPanel>
</Window>
