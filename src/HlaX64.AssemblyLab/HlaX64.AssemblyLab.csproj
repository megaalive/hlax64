<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>HlaX64.AssemblyLab</RootNamespace>
    <AssemblyName>HlaX64.AssemblyLab</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Override Avalonia.FreeDesktop transitive; GHSA-xrw6-gwf8-vvr9 fixed in 0.22+ -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="11.3.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HlaX64.Compiler\HlaX64.Compiler.csproj" />
    <ProjectReference Include="..\HlaX64.Backend.Nasm\HlaX64.Backend.Nasm.csproj" />
    <ProjectReference Include="..\HlaX64.Cli\HlaX64.Cli.csproj" />
    <ProjectReference Include="..\HlaX64.DebugAdapter\HlaX64.DebugAdapter.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\editors\vscode\syntaxes\hla64.tmLanguage.json" Link="Assets\syntax\hla64\syntaxes\hla64.tmLanguage.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Assets\syntax\hla64\package.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\data\instructions.json" Link="data\instructions.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
