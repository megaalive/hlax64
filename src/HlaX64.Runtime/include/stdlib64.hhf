// HlaX64 Standard Library - 64-bit Header
// File: stdlib64.hhf
// Target: linux-x64-sysv
//
// This header is documentation/prototype for the runtime functions
// provided by the HlaX64 Runtime. The MVP compiler currently inlines
// equivalent syscalls; this file documents the stable runtime API that
// will be linked in for procedure-aware compilation and C# interop.

#ifndef HLA_STDLIB64
#define HLA_STDLIB64

// =====================================================================
// Constants
// =====================================================================

// nl - newline character (0x0A)
// Use: stdout.put("Hello", nl);
#define nl              0x0A

// Standard file descriptors (Linux System V ABI)
#define stdin_fd        0
#define stdout_fd       1
#define stderr_fd       2

// Standard result codes for hlax_* runtime helpers.
#define HLAX_OK                 0
#define HLAX_ERR                -1
#define HLAX_ERR_TIMEOUT        -2
#define HLAX_ERR_UNSUPPORTED    -3
#define HLAX_ERR_NAME_NOT_FOUND -4

// Tool exit codes (convention for examples/tools).
#define HLAX_EXIT_OK            0
#define HLAX_EXIT_USAGE         1
#define HLAX_EXIT_OS            2
#define HLAX_EXIT_NET           3

// Linux x64 syscall numbers (subset)
#define SYS_READ        0
#define SYS_WRITE       1
#define SYS_EXIT        60

// =====================================================================
// Runtime Functions (defined in linux-x64/stdout.nasm)
// =====================================================================

// Prints a NUL-terminated string to stdout.
//   rdi = pointer to string buffer
//   rax, rcx, rdx, rsi are clobbered
procedure stdout_put_str(buf:ptr); @returns("void");

// Prints a single newline character to stdout.
procedure stdout_put_nl; @returns("void");

// Prints a signed 64-bit integer in decimal to stdout.
//   rdi = integer value to print
procedure stdout_put_int(value:int64); @returns("void");

// Prints an unsigned 64-bit integer in decimal to stdout (bit pattern).
//   rdi = integer value to print
procedure stdout_put_uint(value:int64); @returns("void");

// High-level: stdout.put("text", nl); stdout.putu(hash, nl);

// =====================================================================
// Command-line argv (Windows: GetCommandLineA parser in windows-x64/argv.nasm)
// =====================================================================

// Parse argc/argv once (idempotent). Linux: captured from kernel stack at _start via hlax_argv_save_from_stack.
procedure hlax_argv_init(); @returns("rax");

// Return argument count (includes argv[0] program name).
procedure hlax_argv_count(); @returns("rax");

// Return argv[index] pointer, or 0 when out of range.
// Windows: ANSI cstring from GetCommandLineA (use CreateFileA for argv[1] paths).
// Linux: UTF-8 cstring pointers from the kernel stack (valid for process lifetime).
procedure hlax_argv_get(index:int64); @returns("rax");

// =====================================================================
// Heap (linux-x64/heap.nasm wraps libc; windows-x64/heap.nasm uses HeapAlloc)
// =====================================================================

// Allocate size bytes (zero-filled on Windows). Returns 0 on failure.
procedure hlax_malloc(size:uint64); @returns("rax");

// Resize block at ptr to size bytes (ptr may be 0). Returns 0 on failure.
procedure hlax_realloc(ptr:ptr; size:uint64); @returns("rax");

// Free block at ptr (no-op when ptr is 0).
procedure hlax_free(ptr:ptr): void;

// =====================================================================
// File I/O (linux-x64/file.nasm, windows-x64/file.nasm)
// =====================================================================

// Return 1 when path exists, 0 when missing.
procedure hlax_path_exists(path: cstring): int64;

// Open path for read-only access. Returns handle/fd, or -1 on failure.
procedure hlax_file_open_read(path: cstring): int64;

// Read up to count bytes into buffer. Returns bytes read, or -1 on failure.
procedure hlax_file_read(handle: int64; buffer: ptr; count: uint64): int64;

// Close handle/fd opened with hlax_file_open_read or hlax_file_open_write.
procedure hlax_file_close(handle: int64): int64;

// Open path for write (truncate/create). Returns handle/fd, or -1 on failure.
procedure hlax_file_open_write(path: cstring): int64;

// Write up to count bytes from buffer. Returns bytes written, or -1 on failure.
procedure hlax_file_write(handle: int64; buffer: ptr; count: uint64): int64;

// Write up to count bytes to stdout. Returns bytes written, or -1 on failure.
procedure hlax_stdout_write(buffer: ptr; count: uint64): int64;

// =====================================================================
// String / memory (linux-x64/mem.nasm, windows-x64/mem.nasm)
// =====================================================================

// Length of NUL-terminated UTF-8/ANSI cstring (bytes before NUL).
procedure hlax_strlen(buf: cstring): uint64;

// Copy count bytes from src to dst. Returns dst.
procedure hlax_memcpy(dst: ptr; src: ptr; count: uint64): ptr;

// Fill count bytes at dst with low byte of value. Returns dst.
procedure hlax_memset(dst: ptr; value: uint64; count: uint64): ptr;

// Return 1 for space/tab/LF/CR, else 0.
procedure hlax_is_space(ch: uint64): int64;

// Return 1 for ASCII printable (0x20..0x7E), else 0.
procedure hlax_is_printable(ch: uint64): int64;

// =====================================================================
// System / machine (linux-x64/sys.nasm, windows-x64/sys.nasm)
// =====================================================================

// Return current process id.
procedure hlax_getpid(): int64;

// Write hostname into buffer (NUL-terminated). Returns byte length or -1.
procedure hlax_hostname(buffer: ptr; capacity: uint64): int64;

// Seconds since boot (Windows: tick-based via GetTickCount64).
procedure hlax_uptime_secs(): int64;

// Total physical memory in bytes, or -1 on failure.
procedure hlax_mem_total(): int64;

// Available physical memory in bytes, or -1 on failure.
procedure hlax_mem_avail(): int64;

// File size in bytes for path, or -1 on failure.
procedure hlax_file_size(path: cstring): int64;

// Last OS error (Linux: errno, Windows: GetLastError()).
procedure hlax_os_last_error(): int64;

// Online CPU count, or -1 on failure.
procedure hlax_cpu_count(): int64;

// Total disk bytes for path mount, or -1 on failure.
procedure hlax_disk_total_bytes(path: cstring): int64;

// Available disk bytes for path mount, or -1 on failure.
procedure hlax_disk_avail_bytes(path: cstring): int64;

// Resident set size for current process in bytes, or -1 on failure.
procedure hlax_self_rss_bytes(): int64;

// One-minute load average in milli-units (Linux only), or -1 / HLAX_ERR_UNSUPPORTED.
procedure hlax_load_avg_milli(): int64;

// =====================================================================
// Network (linux-x64/net.nasm, windows-x64/net.nasm)
// IPv4 literal and DNS hostname connect; timeouts and reliable write.
// =====================================================================

// Initialize networking (WSAStartup on Windows; no-op on Linux). Returns 0 or -1.
procedure hlax_net_init(): int64;

// Last network error (Linux: errno, Windows: WSAGetLastError()).
procedure hlax_net_last_error(): int64;

// Resolve host to dotted IPv4 string in out_buf. Returns length or -1.
procedure hlax_dns_resolve_v4(host: cstring; out_buf: ptr; capacity: uint64): int64;

// Connect TCP to host:port (IPv4 literal). Returns socket handle/fd or -1.
procedure hlax_tcp_connect(host: cstring; port: uint64): int64;

// Connect TCP using DNS (IPv4). Returns socket handle/fd or -1.
procedure hlax_tcp_connect_name(host: cstring; port: uint64): int64;

// Connect with timeout in milliseconds. Returns socket or -1.
procedure hlax_tcp_connect_timeout(host: cstring; port: uint64; timeout_ms: uint64): int64;

// Set socket recv/send timeouts in milliseconds. Returns 0 or -1.
procedure hlax_tcp_set_timeouts_ms(socket: int64; recv_ms: uint64; send_ms: uint64): int64;

// Write up to count bytes. Returns bytes sent or -1.
procedure hlax_tcp_write(socket: int64; buffer: ptr; count: uint64): int64;

// Write all count bytes (handles partial send). Returns count or -1.
procedure hlax_tcp_write_all(socket: int64; buffer: ptr; count: uint64): int64;

// Read up to count bytes. Returns bytes read or -1.
procedure hlax_tcp_read(socket: int64; buffer: ptr; count: uint64): int64;

// Read up to count bytes (explicit alias). Returns bytes read or -1.
procedure hlax_tcp_read_once(socket: int64; buffer: ptr; count: uint64): int64;

// Close socket. Returns 0 or -1.
procedure hlax_tcp_close(socket: int64): int64;

// =====================================================================
// Conversion (defined in linux-x64/conversion.nasm)
// =====================================================================

// Converts a signed 64-bit integer to a NUL-terminated decimal string.
//   rdi = integer value
//   rsi = pointer to output buffer (at least 21 bytes)
//   rax = pointer to output buffer (same as rsi on return)
procedure int_to_str(value:int64; buf:ptr); @returns("rax");

// Converts an unsigned 64-bit integer (bit pattern) to a NUL-terminated decimal string.
procedure uint_to_str(value:int64; buf:ptr); @returns("rax");

// =====================================================================
// Startup (defined in linux-x64/startup.nasm)
// =====================================================================

// Program entry point. Invoked by the Linux kernel.
// _start should be the only global symbol in the final executable.
procedure _start; @noreturn;

#endif // HLA_STDLIB64
