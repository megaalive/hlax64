{
  "name": "hla64",
  "displayName": "HlaX64",
  "description": "Syntax highlighting and snippets for HlaX64 (.hla64)",
  "version": "0.1.0",
  "publisher": "megaalive",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "hla64",
      "aliases": ["HlaX64", "hla64"],
      "extensions": [".hla64"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "hla64",
      "scopeName": "source.hla64",
      "path": "./syntaxes/hla64.tmLanguage.json"
    }],
    "snippets": [{
      "language": "hla64",
      "path": "./snippets/hla64.json"
    }]
  }
}
