// export_lib.hla64
// Sample shared library with exported procedures for C/C# interop.

program export_lib;

export procedure Double(x:int64); @returns("rax");
begin Double;
    mov(x, rax);
    add(rax, rax);
end Double;

export procedure Add(a:int64; b:int64); @returns("rax");
begin Add;
    mov(a, rax);
    add(b, rax);
end Add;

// Internal procedure (not exported)
procedure Triple(x:int64); @returns("rax");
begin Triple;
    mov(x, rax);
    add(rax, rax);
    add(x, rax);
end Triple;

begin export_lib;
end export_lib;
