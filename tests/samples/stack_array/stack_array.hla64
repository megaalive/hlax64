program stack_array;

procedure SumThree; @returns("rax");
var
    data: int64[3];
begin SumThree;
    mov(10, data[0]);
    mov(20, data[1]);
    mov(30, data[2]);
    mov(data[0], rax);
    mov(data[1], rbx);
    add(rbx, rax);
    mov(data[2], rbx);
    add(rbx, rax);
end SumThree;

begin stack_array;
    call SumThree();
end stack_array;
