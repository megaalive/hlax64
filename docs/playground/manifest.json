        {
          "id": "linecount",
          "label": "File read",
          "path": "examples/tools/10-windows/linecount/linecount.hla64",
          "run": "hla64 run examples/tools/10-windows/linecount/linecount.hla64 -- README.md",
          "expected": "stdout:\n  lines: <n>\nUses argv[1] as the file path to read."
        },
        {
          "id": "argv",
          "label": "argv",
          "path": "examples/tools/10-windows/exists/exists.hla64",
          "run": "hla64 run examples/tools/10-windows/exists/exists.hla64 -- .",
          "expected": "About argc / argv:\n  hlax_argv_count() → argc (argv[0] program name + user args)\n  hlax_argv_get(1)  → argv[1] (first user argument)\n\nRun with a path that exists:\n  hla64 run examples/tools/10-windows/exists/exists.hla64 -- .\n\nstdout:\n  exists\nexit code: 0\n\nRun with a missing path:\n  hla64 run examples/tools/10-windows/exists/exists.hla64 -- __missing__\n\nstdout:\n  missing\nexit code: 1"
        },
        {
          "id": "wc",
